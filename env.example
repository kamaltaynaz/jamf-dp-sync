# Copy to ~/.config/jamf-dp-sync/env and chmod 600 (spec section 5).
# The agent refuses to start if this file is readable by group or others.
# Never commit a filled-in copy.
JAMF_URL=
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=
GITHUB_TOKEN=
# Incoming webhook for notifications: Google Chat, Slack, or a Microsoft Teams Workflows URL.
WEBHOOK_URL=
# Optional: gchat, slack or teams. Empty = detect from the WEBHOOK_URL host.
WEBHOOK_KIND=
# Older name for WEBHOOK_URL (Google Chat); still read when WEBHOOK_URL is empty.
GCHAT_WEBHOOK_URL=
